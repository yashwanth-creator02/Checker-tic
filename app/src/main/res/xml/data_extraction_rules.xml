<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (cloud backup and device transfer).

    Voice recordings are excluded from cloud backup: a locked note's audio is
    encrypted with a device-bound key that cannot leave this device, so
    uploading it would waste the user's backup quota on bytes nothing could
    ever open. Device-to-device transfer keeps them, since the keystore key
    moves with a direct transfer on supported devices.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="backgrounds/" />
        <include domain="sharedpref" path="checker_tic_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="backgrounds/" />
        <include domain="file" path="voice/" />
        <include domain="sharedpref" path="checker_tic_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
